# --- Server ---
PORT=5050
NODE_ENV=development
# Where the React app runs (used for CORS + OAuth redirects back to the UI)
CLIENT_URL=http://localhost:5173

# --- Auth ---
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vrun

# --- Google Fit (optional) ---
# Leave blank to run on the fallback demo data (data/fallback-steps.json).
# Note: Google closed new Fitness API sign-ups in May 2024 and is retiring the API in 2026.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/googlefit/callback

# --- Product ---
DAILY_GOAL=10000
